+/* Móvil y tableta (< 960 px, donde la portada es verde): la barra usa el mismo verde bosque que
+   la parte superior de la portada, sin borde ni sombra, y forma un solo fondo con ella. El logo va
+   en una píldora blanca, como en la barra oscura del diseño («B»), sin filtros sobre sus colores. */
+@media (max-width: 959px) {
+  .nav {
+    background: rgb(var(--forest));
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+
+  .nav__logo {
+    background: #fff;
+    border-radius: 999px;
+    padding: 6px 14px;
+  }
+
+  .nav__logo-img {
+    height: 32px;
+    mix-blend-mode: normal;
+  }
+
+  .nav__link {
+    color: #faf6ee;
+  }
+
+  .nav__menu {
+    background: transparent;
+    border: 1px solid rgba(250, 246, 238, 0.38);
+    color: #faf6ee;
+  }
+
+  .nav :focus-visible {
+    outline-color: #faf6ee;
+  }
+}
+
+/* Menú desplegado en móvil: panel del mismo verde con enlaces crema y separadores claros. */
+@media (max-width: 767px) {
+  .nav__links {
+    background: rgb(var(--forest));
+    border-bottom: 1px solid rgba(250, 246, 238, 0.14);
+    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.28);
+  }
+
+  .nav__link {
+    border-top-color: rgba(250, 246, 238, 0.14);
+  }
+}
+
+/* Pantallas muy angostas: píldora del logo más compacta para que quepan WhatsApp y el menú. */
+@media (max-width: 379px) {
+  .nav__logo {
+    padding: 6px 10px;
+  }
+
+  .nav__logo-img {
+    height: 30px;
+  }
+}
+
 @media (hover: hover) and (pointer: fine) {
   .nav__logo:hover {
     transform: rotate(-3deg) scale(1.04);
